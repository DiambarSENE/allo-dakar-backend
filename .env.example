# Copier en .env pour un usage local avec docker-compose. Ne jamais committer .env avec de vraies valeurs.

SPRING_PROFILES_ACTIVE=dev

# --- Base de données applicative ---
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/allo_dakar
SPRING_DATASOURCE_USERNAME=allo_dakar
SPRING_DATASOURCE_PASSWORD=change-me

POSTGRES_DB=allo_dakar
POSTGRES_USER=allo_dakar
POSTGRES_PASSWORD=change-me

# --- Base de données Keycloak (dédiée, distincte de celle de l'application) ---
KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change-me

# --- Keycloak (Authorization Server) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_PORT=8081

# Vu par le CONTENEUR backend (réseau interne Docker) pour valider les tokens (JWK Set) —
# distinct de l'URL utilisée par le navigateur/mobile pour obtenir ses tokens. En local sans
# Docker, les deux valent http://localhost:8081/realms/allo-dakar.
KEYCLOAK_ISSUER_URI=http://keycloak:8080/realms/allo-dakar
KEYCLOAK_SERVER_URL=http://keycloak:8080
KEYCLOAK_REALM=allo-dakar

# Client confidentiel "allo-dakar-backend-admin" (service account, rôle manage-users) — voir
# keycloak/realm-export.json. La valeur ici DOIT correspondre au "secret" défini dans ce fichier
# (ou à la valeur régénérée depuis la console Keycloak si vous ne réutilisez pas l'export tel quel).
KEYCLOAK_ADMIN_CLIENT_ID=allo-dakar-backend-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=change-me-match-realm-export-json

CORS_ALLOWED_ORIGINS=http://localhost:4200

SERVER_PORT=8080
